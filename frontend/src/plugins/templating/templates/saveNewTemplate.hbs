<h1>✨Save {{_type}} template!</h1>
<div class="new-template-form">
    <div class="form-input">
        <label>Name of template</label>
        <input id="templateName" type="text" name="name" placeholder="Name for the {{_type}} template" />
    </div>
    <div class="form-input">
        <label>Description</label>
        <input id="templateDescription" type="text" name="description" placeholder="Description for the {{_type}} template" />
    </div>
    <!-- Sharing fields (Share with all users / Share with specific users) are
         rendered here via a Backbone scaffold form, identical to Project Settings. -->
    <div id="templateShareForm" class="template-share-form"></div>
</div>
